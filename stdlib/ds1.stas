; Dark Souls: Prepare to Die Edition button names and action macros, for the
; game's default (un-remapped) Xbox 360 controller layout. Double check these
; against your own in-game control settings if you've rebound anything -
; edit the consts below, everything else keeps working unchanged.

import "std/buttons"
import "std/movement"

const BTN_ROLL     = "b"              ; roll / backstep / dash
const BTN_INTERACT = "a"              ; use / interact / climb ladders fast
const BTN_USE_ITEM = "x"              ; use the selected item (e.g. Estus)
const BTN_TWOHAND  = "y"              ; hold to two-hand the right weapon
const BTN_ATTACK_R = "shoulder_right" ; RB - right hand light attack
const BTN_ATTACK_L = "shoulder_left"  ; LB - left hand light attack / parry
const BTN_LOCKON   = "stick_right"    ; R3 - toggle lock on
const BTN_START    = "start"          ; pause / open menu

const AXIS_ATTACK_R_HEAVY = "trigger_right" ; RT - right hand strong attack
const AXIS_GUARD_L        = "trigger_left"  ; LT - block / left hand strong attack

fn roll_ds1(angle, hold) {
    roll(angle, $BTN_ROLL, hold)
}

fn roll_ds1_direction(direction, hold) {
    roll_direction(direction, $BTN_ROLL, hold)
}

fn attack_right(hold) {
    tap_button($BTN_ATTACK_R, hold)
}

fn attack_right_heavy(hold) {
    tap_trigger($AXIS_ATTACK_R_HEAVY, hold)
}

fn attack_left(hold) {
    tap_button($BTN_ATTACK_L, hold)
}

; Holds block for `frames`. A short `frames` (a couple of frames) with a
; parry-capable weapon/shield equipped in the left hand attempts a parry -
; tune the exact frame count to your target's attack timing.
fn guard(frames) {
    press_trigger($AXIS_GUARD_L)
    wait frames
    release_trigger($AXIS_GUARD_L)
}

fn use_item(hold) {
    tap_button($BTN_USE_ITEM, hold)
}

fn interact(hold) {
    tap_button($BTN_INTERACT, hold)
}

fn twohand(hold) {
    tap_button($BTN_TWOHAND, hold)
}

fn lockon(hold) {
    tap_button($BTN_LOCKON, hold)
}

fn open_menu(hold) {
    tap_button($BTN_START, hold)
}

; "TAS-sprint": wiggles the left stick between full tilt and neutral while
; holding roll and tapping l1 (BTN_ATTACK_L), covering ground faster than the
; game's normal max run speed. `angle` is the stick direction (see
; std/gamepad), `cycles` is the total number of hold/release/tap repeats to
; perform - the first one holds the stick for 30 frames to reach full run
; speed, every following one only needs a 10-frame hold to maintain it,
; matching a captured reference .tas of the technique. Caller is expected to
; have already done `await focus` (and any settling wait) before calling
; this - it doesn't do that itself.
fn tas_sprint(angle, cycles) {
    press_button($BTN_ROLL)
    wait 1
    left_stick(angle, 1)
    wait 1
    tap_button($BTN_ATTACK_L, 1)
    repeat cycles - 1 {
        wait 10
        left_stick(angle, 0)
        wait 1
        left_stick(angle, 1)
        wait 1
        tap_button($BTN_ATTACK_L, 1)
    }
    wait 1
}
