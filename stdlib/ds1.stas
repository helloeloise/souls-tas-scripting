; Dark Souls: Prepare to Die Edition button names and action macros, for the
; game's default (un-remapped) Xbox 360 controller layout. Double check these
; against your own in-game control settings if you've rebound anything -
; edit the consts below, everything else keeps working unchanged.

import "std/buttons"
import "std/gamepad"
import "std/generic_functions"

const BTN_ROLL     = "b"              ; roll / backstep / dash
const BTN_INTERACT = "a"              ; use / interact
const BTN_USE_ITEM = "x"              ; use the selected item (e.g. Estus)
const BTN_TWOHAND  = "y"              ; press to two-hand the right weapon
const BTN_ATTACK_R = "shoulder_right" ; RB - right hand light attack
const BTN_ATTACK_L = "shoulder_left"  ; LB - left hand light attack / block
const BTN_LOCKON   = "stick_right"    ; R3 - toggle lock on
const BTN_START_MENU    = "start"          ; pause / open menu

const AXIS_ATTACK_R_HEAVY = "trigger_right" ; RT - right hand strong attack
const AXIS_PARRY_L        = "trigger_left"  ; LT - left hand strong attack / parry

fn roll(angle) {
    roll_generic(angle, $BTN_ROLL)
}

fn roll_direction(direction) {
    roll_direction_generic(direction, $BTN_ROLL)
}

; Assumes the player is already sprinting
fn jump(angle) {
    release_button($BTN_ROLL)
    wait 1
    press_button($BTN_ROLL)
    left_stick(angle, 1)
    wait 2
    release_button($BTN_ROLL)
    left_stick(0, 0)
}

fn attack_right() {
    tap_button($BTN_ATTACK_R)
}

fn attack_right_heavy() {
    tap_trigger($AXIS_ATTACK_R_HEAVY)
}

fn attack_left() {
    tap_button($BTN_ATTACK_L)
}

fn block(frames) {
    hold_button($BTN_ATTACK_L, frames)
}

fn use_item() {
    tap_button($BTN_USE_ITEM)
}

fn interact() {
    tap_button($BTN_INTERACT)
}

fn twohand() {
    tap_button($BTN_TWOHAND)
}

fn lockon() {
    tap_button($BTN_LOCKON)
}

fn open_menu() {
    tap_button($BTN_START_MENU)
}

fn open_inventory() {
    start()
    wait 5
    a()
}

fn open_equipment() {
    start()
    wait 5
    right()
    a()
}

fn open_stats() {
    start()
    wait 5
    right()
    right()
    a()
}

fn open_settings() {
    start()
    wait 5
    left()
    a()
}

; Quitout to main menu
fn quitout() {
    open_settings()
    wait 1
    up()
    a()
    wait 1
    left()
    a()
}

; Load first character slot when currently in main menu with Load Game highlighted
fn load_character() {
    a()
    wait 27
    a()
}

; Quitout of game and reload the first character. r3sus dll with nopsb enabled required
fn quitout_reload() {
    quitout()
    await mainmenu
    wait 16
    load_character()
}

; Spellswap used for Homeward Wrong Warp. Inputs L1 + Dpad Up one frame, R1 the next
fn spellswap() {
    l1_press()
    up_press()
    wait 1
    l1_release()
    up_release()
    r1_press()
    wait 1
    r1_release()
}

; Classic moveswap. Use at whatever point in the animation (roll, foggate traversal, ...) a moveswap becomes possible.
fn moveswap() {
    l1()
    open_equipment()
    wait 1
    down()
    a()
    wait 2
    up()
    a()
    wait 1
    start()
}

; TAS sprint wiggles the left stick between full tilt and neutral while
; holding sprint and tapping L1, covering ground faster than the
; game's normal max run speed. `angle` is the stick direction,
;`cycles` is the total number of hold/release/tap repeats to perform.
fn tas_sprint_start(angle, cycles) {
    b_press()
    left_stick(angle, 1)
    wait 1
    l1()
    repeat cycles - 1 {
        wait 10
        left_stick(angle, 0)
        wait 1
        left_stick(angle, 1)
        wait 1
        l1()
    }
}

fn tas_sprint(angle, cycles) {
    repeat cycles - 1 {
        wait 10
        left_stick(angle, 0)
        wait 1
        left_stick(angle, 1)
        wait 1
        l1()
    }
}

fn first_roll_tier_moveswap()
{
    roll(0)
    left_stick(0, 1)
    wait 7
    moveswap();
}

fn second_roll_tier_moveswap()
{
    roll(0)
    left_stick(0, 1)
    wait 8
    moveswap();
}

fn third_roll_tier_moveswap()
{
    roll(0)
    left_stick(0, 1)
    wait 9
    moveswap();
}
