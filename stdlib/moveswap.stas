import "std/gamepad"
fn first_tier_roll_moveswap()
{
    left_stick_up(1)
    gamepad button down b
    wait 1
    gamepad button up b
    wait 6
    gamepad button down shoulder_left
    wait 1
    gamepad button up shoulder_left
    gamepad button down start
    wait 1
    gamepad button up start
    wait 5
    gamepad button down dpad_right
    wait 1
    gamepad button up dpad_right
    wait 1 
    gamepad button down a
    wait 1
    gamepad button up a
    wait 1
    gamepad button down dpad_down
    wait 1
    gamepad button up dpad_down
    wait 1
    gamepad button down a
    wait 1
    gamepad button up a
    wait 2
    gamepad button down dpad_up
    wait 1
    gamepad button up dpad_up
    wait 1
    gamepad button down a
    wait 1
    gamepad button up a
    wait 1
    gamepad button down start
    wait 1
    gamepad button up start
}